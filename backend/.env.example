PORT=8091
APP_ENV=development

# CORS — comma-separated origins allowed to hit /v1/*
ALLOWED_ORIGINS=http://localhost:3000,https://usecosmoskittool.com,https://www.usecosmoskittool.com

# Inbox that receives /v1/contact and /v1/suggest submissions
CONTACT_EMAIL=contato@usecosmoskittool.com
CONTACT_NAME=CosmoKit Support

# Brevo transactional email — see appkit-go/email
BREVO_API_KEY=
FROM_EMAIL=CosmoKit <contato@usecosmoskittool.com>
APP_NAME=CosmoKit

# Set DEV_EMAIL_SINK to any non-empty value to log emails instead of sending them
DEV_EMAIL_SINK=1
